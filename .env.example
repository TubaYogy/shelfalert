# ---------------------------------------------------------------------------
# ShelfAlert environment configuration
# Copy this file to `.env` and edit the values before `docker compose up -d`.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=changeme_strong_db_password

# --- App ------------------------------------------------------------------
# Host port ShelfAlert is published on (container always listens on 3000).
PORT=3001

# Secret used to sign session cookies AND to encrypt the stored BookOrbit
# token. Generate one with:  openssl rand -hex 32
NEXTAUTH_SECRET=changeme_generate_with_openssl_rand_hex_32

# Public URL of this ShelfAlert instance (used for widget URLs).
NEXTAUTH_URL=http://localhost:3001

# --- Initial admin user (created on first boot only) ----------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_strong_admin_password

# --- Optional: OIDC SSO (Authelia / Authentik) ----------------------------
# Set all three to enable single sign-on (see README "OIDC setup").
# OIDC_CLIENT_ID=shelfalert
# OIDC_CLIENT_SECRET=your_client_secret
# OIDC_ISSUER=https://auth.yourdomain.com

# --- Optional: raise Google Books rate limits -----------------------------
# Not required — the app works without a key. Add one only if you hit limits.
# GOOGLE_BOOKS_API_KEY=
