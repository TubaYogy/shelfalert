{
  "name": "shelfalert",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted tracker for upcoming book releases from your favourite authors, powered by BookOrbit + Google Books + Open Library.",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx server.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.5.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "jose": "5.9.6",
    "lucide-react": "0.454.0",
    "next": "15.1.6",
    "node-cron": "3.0.3",
    "prisma": "6.5.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.6.0",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.7",
    "@types/node-cron": "3.0.11",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
